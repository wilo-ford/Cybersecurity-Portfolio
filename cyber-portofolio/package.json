{
  "name": "mohamed-abogourin-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "check": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-v2.mjs",
    "test:contact": "node scripts/contact-check.cjs",
    "screenshots": "node scripts/visual-check.cjs",
    "build:preview": "pnpm build && node scripts/prepare-preview.mjs",
    "deploy:preview": "pnpm build:preview && wrangler deploy --config wrangler.preview.jsonc",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "lucide-react": "^0.554.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@11.25.0"
}
